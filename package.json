{
  "name": "greygen",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first browser spectral-noise generator and psychoacoustic playground",
  "type": "module",
  "engines": {
    "node": "24.21.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/greygen/",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "characterize": "node scripts/characterize.mjs",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "verify:pwa:pages": "node scripts/verify-pwa-build.mjs --base=/greygen/",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
